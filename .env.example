# ==========================================
# Money Dashboard Environment Variables
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI Financial Insights (gemini-2.5-flash).
# In Google AI Studio, this is automatically injected from user secrets.
# For local dev: obtain a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: For the Google Sheets connector.
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# STRIPE_SECRET_KEY: Read-only restricted key for importing payment charges as Product Sales.
# Create in Stripe Dashboard -> Developers -> API Keys -> Restricted key (charges: read, balance_transactions: read)
STRIPE_SECRET_KEY="rk_live_or_test_your_restricted_read_only_key"

# SESSION_SECRET: Used for securing OAuth session state cookies
SESSION_SECRET="money-dashboard-session-secret-change-me"

# APP_URL: Base URL where the app is hosted (e.g. http://localhost:3000)
APP_URL="http://localhost:3000"

# PORT: Server listening port
PORT="3000"
